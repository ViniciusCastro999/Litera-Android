# Copy this file to "local.properties" (same folder), which Android Studio
# also uses to store your sdk.dir automatically.
#
# Optional: a Google Books API key raises your request quota.
# Get one free at https://console.cloud.google.com/apis/credentials
# (enable "Books API" on the project first). The app works without it too,
# just at a lower, shared quota.
booksApiKey=

# Optional: OAuth Web Client ID for "Continuar com Google" (login/cadastro).
# Get it from the Firebase Console: Authentication -> Sign-in method ->
# Google -> enable it -> "Web SDK configuration" shows the Web client ID.
# See README.md "Login com Google". Without it, the Google button is hidden.
googleWebClientId=
